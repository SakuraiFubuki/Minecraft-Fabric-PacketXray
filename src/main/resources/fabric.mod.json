{
	"schemaVersion": 1,
	"id": "packetxray",
	"version": "${version}",
	"name": "Packet Xray",
	"description": "批量发包剥掉服务端的Anti-Xray伪装,透视任意自定义方块(/packetxray)",
	"authors": ["SakuraiFubuki", "DeepSeek"],
	"contact": {
		"homepage": "https://github.com/SakuraiFubuki/Minecraft-Fabric-PacketXray",
		"sources": "https://github.com/SakuraiFubuki/Minecraft-Fabric-PacketXray",
		"issues": "https://github.com/SakuraiFubuki/Minecraft-Fabric-PacketXray/issues"
	},
	"license": "MIT",
	"icon": "assets/packetxray/icon.png",
